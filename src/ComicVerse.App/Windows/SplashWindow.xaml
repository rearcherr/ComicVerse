<Window x:Class="ComicVerse.App.Windows.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ComicVerse"
        Width="520" Height="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI">
    <Border CornerRadius="20" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A1A2E" Offset="0"/>
                <GradientStop Color="#221A3E" Offset="0.55"/>
                <GradientStop Color="#3A1B52" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <!-- 装饰圆 -->
                <Ellipse Width="260" Height="260" Opacity="0.18" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-70,-60,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF6B9D" Offset="0"/>
                            <GradientStop Color="#00FF6B9D" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="300" Height="300" Opacity="0.14" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="-110,0,0,-110">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#C44CEC" Offset="0"/>
                            <GradientStop Color="#00C44CEC" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="✦" FontSize="46" Foreground="#FF8FB8" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LogoText" Text="ComicVerse" FontSize="34" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock Text="二次元漫画 · 轻小说阅读器" FontSize="13" Foreground="#B9AECF"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock x:Name="StatusText" Text="正在加载书库…" FontSize="12" Foreground="#8F85AB"
                               HorizontalAlignment="Center" Margin="0,30,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="60,0,60,44">
                <ProgressBar x:Name="SplashProgress" Height="5" Minimum="0" Maximum="100">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border Background="#33334F" CornerRadius="2.5">
                                            <Grid ClipToBounds="True">
                                                <Border x:Name="PART_Indicator" CornerRadius="2.5"
                                                        HorizontalAlignment="Left">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#FF6B9D" Offset="0"/>
                                                            <GradientStop Color="#C44CEC" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Text="为你准备一场美好的阅读之旅" FontSize="11" Foreground="#6F6590"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
