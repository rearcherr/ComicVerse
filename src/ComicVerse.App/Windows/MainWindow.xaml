<Window x:Class="ComicVerse.App.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:ComicVerse.App.Helpers"
        Title="ComicVerse — 书架"
        Width="1280" Height="820" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <helpers:CoverPathConverter x:Key="CoverConv"/>
        <helpers:PercentTextConverter x:Key="PctConv"/>
        <helpers:LastReadTextConverter x:Key="LastReadConv"/>
        <helpers:BookTypeTextConverter x:Key="TypeConv"/>

        <DataTemplate x:Key="BookCardTemplate">
            <Button Tag="{Binding}" Click="BookCard_Click" MouseRightButtonDown="BookCard_ContextMenu"
                    Background="Transparent" Padding="0" Width="150" Margin="0,0,16,20"
                    Style="{StaticResource BaseButton}" HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="12" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="202"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}">
                                    <Image Source="{Binding CoverPath, Converter={StaticResource CoverConv}}"
                                           Stretch="UniformToFill"/>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                            Background="#B3141424" CornerRadius="10" Padding="8,3">
                                        <TextBlock Text="{Binding FormatText}" FontSize="10" Foreground="White"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="10,8,10,8">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxHeight="38" TextWrapping="Wrap"/>
                                    <Grid Margin="0,8,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding Progress}"
                                                     Style="{StaticResource MiniProgress}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Progress, Converter={StaticResource PctConv}}"
                                                   FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding LastReadTime, Converter={StaticResource LastReadConv}}"
                                               FontSize="10" Foreground="{DynamicResource TextFaintBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="BookRowTemplate">
            <ItemsControl ItemsSource="{Binding Books}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <StaticResource ResourceKey="BookCardTemplate"/>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="BookListTemplate">
            <Button Tag="{Binding}" Click="BookCard_Click" MouseRightButtonDown="BookCard_ContextMenu"
                    Background="Transparent" Padding="0" Margin="0,0,0,8"
                    Style="{StaticResource BaseButton}" HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}">
                                    <Image Source="{Binding CoverPath, Converter={StaticResource CoverConv}}"
                                           Stretch="UniformToFill" Width="48" Height="64"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FilePath}" FontSize="11"
                                               Foreground="{DynamicResource TextFaintBrush}" TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Type, Converter={StaticResource TypeConv}}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding FormatText}" FontSize="11"
                                               Foreground="{DynamicResource TextFaintBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Grid Grid.Column="3" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding Progress}"
                                                 Style="{StaticResource MiniProgress}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Progress, Converter={StaticResource PctConv}}"
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock Grid.Column="4" Text="{Binding LastReadTime, Converter={StaticResource LastReadConv}}"
                                           FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                                           VerticalAlignment="Center" TextAlignment="Right"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HeaderGradientBrush}" Padding="20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✦" FontSize="22" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="ComicVerse" FontSize="18" FontWeight="Bold" Foreground="White"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="二次元漫画 · 轻小说阅读器" FontSize="11" Foreground="#E8DFF5"
                               Margin="10,0,0,2" VerticalAlignment="Bottom"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" ToolTip="切换深浅主题" Click="ThemeButton_Click">
                        <TextBlock Text="☾" FontSize="16" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="设置" Click="SettingsButton_Click" Margin="4,0,0,0">
                        <TextBlock Text="⚙" FontSize="16" Foreground="White"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource WindowBgBrush}" Padding="20,10"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}" Click="AddFiles_Click" Content="＋ 添加文件"/>
                    <Button Style="{StaticResource BaseButton}" Click="AddFolder_Click" Content="＋ 添加文件夹" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="GridModeButton" Style="{StaticResource IconButton}" ToolTip="网格视图" Click="GridMode_Click" Margin="0,0,4,0">
                        <TextBlock Text="▦" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                    <Button x:Name="ListModeButton" Style="{StaticResource IconButton}" ToolTip="列表视图" Click="ListMode_Click">
                        <TextBlock Text="☰" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0">
                    <ComboBox x:Name="SortBox" Style="{StaticResource ComboStyle}" Width="130" SelectionChanged="SortBox_SelectionChanged">
                        <ComboBoxItem Content="最近阅读" IsSelected="True"/>
                        <ComboBoxItem Content="书名"/>
                        <ComboBoxItem Content="添加时间"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0">
                    <RadioButton x:Name="FilterAll" Style="{StaticResource SegmentRadio}" Content="全部" IsChecked="True"
                                 GroupName="BookFilter" Checked="Filter_Changed" Margin="0,0,6,0"/>
                    <RadioButton x:Name="FilterComic" Style="{StaticResource SegmentRadio}" Content="漫画"
                                 GroupName="BookFilter" Checked="Filter_Changed" Margin="0,0,6,0"/>
                    <RadioButton x:Name="FilterNovel" Style="{StaticResource SegmentRadio}" Content="小说"
                                 GroupName="BookFilter" Checked="Filter_Changed"/>
                </StackPanel>
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBox}" Width="240"
                         TextChanged="SearchBox_TextChanged" ToolTip="搜索书名或路径"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <ListBox x:Name="ShelfList"
                     Background="Transparent" BorderThickness="0" Padding="24,20,24,16"
                     ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     HorizontalContentAlignment="Left">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <StaticResource ResourceKey="BookRowTemplate"/>
                </ListBox.ItemTemplate>
            </ListBox>

            <ListBox x:Name="ListView" Visibility="Collapsed"
                     Background="Transparent" BorderThickness="0" Padding="24,16,24,16"
                     ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <StaticResource ResourceKey="BookListTemplate"/>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="✦" FontSize="64" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="书架还是空的" FontSize="20" FontWeight="Bold" Margin="0,18,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="把漫画或小说文件/文件夹拖进窗口，或点击「添加文件」开始" FontSize="13" Margin="0,10,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <Border x:Name="DragOverlay" Visibility="Collapsed" Background="#66221A3E" Margin="16">
                <Border BorderBrush="#FFF36C9C" BorderThickness="2" CornerRadius="16" Margin="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⇩" FontSize="56" Foreground="#FFF36C9C" HorizontalAlignment="Center"/>
                        <TextBlock Text="松开鼠标，导入到书架" FontSize="18" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Text="支持 CBZ/CBR/CBT/7Z/PDF/TXT/EPUB 与图片文件夹，自动识别类型"
                                   FontSize="12" Foreground="#D9CFE8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="20,7">
            <TextBlock x:Name="StatusText" Text="共 0 本书" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Window>
