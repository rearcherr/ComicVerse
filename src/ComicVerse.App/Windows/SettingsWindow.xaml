<Window x:Class="ComicVerse.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="560" Height="620" MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">
            <TextBlock Style="{StaticResource PageTitleText}" Text="设置"/>

            <TextBlock Style="{StaticResource SectionTitleText}" Text="外观" Margin="0,24,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="主题" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton x:Name="DarkRadio" Style="{StaticResource SegmentRadio}" Content="深色" GroupName="Theme" Margin="0,0,8,0"/>
                    <RadioButton x:Name="LightRadio" Style="{StaticResource SegmentRadio}" Content="浅色" GroupName="Theme"/>
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource SectionTitleText}" Text="性能（大文件漫画）" Margin="0,26,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="缓存上限" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <Slider x:Name="CacheSlider" Minimum="128" Maximum="2048" TickFrequency="64" ValueChanged="CacheSlider_ValueChanged"/>
                    <TextBlock x:Name="CacheText" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="预加载页数" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                <ComboBox x:Name="PrefetchBox" Style="{StaticResource ComboStyle}" Width="140" HorizontalAlignment="Left"
                          SelectionChanged="PrefetchBox_SelectionChanged">
                    <ComboBoxItem Content="0 页（关闭）"/>
                    <ComboBoxItem Content="1 页"/>
                    <ComboBoxItem Content="2 页"/>
                    <ComboBoxItem Content="3 页"/>
                    <ComboBoxItem Content="4 页（推荐）"/>
                    <ComboBoxItem Content="5 页"/>
                    <ComboBoxItem Content="6 页"/>
                    <ComboBoxItem Content="8 页"/>
                </ComboBox>
            </Grid>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="低性能模式" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <ToggleButton x:Name="LowPerfToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left" Checked="LowPerf_Changed" Unchecked="LowPerf_Changed"/>
                    <TextBlock Text="降低缓存与预加载，适合老电脑（打开 5GB+ 合集）" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource SectionTitleText}" Text="阅读偏好" Margin="0,26,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="日漫翻页方向" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <ToggleButton x:Name="RtlToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left" Checked="Rtl_Changed" Unchecked="Rtl_Changed"/>
                    <TextBlock Text="开启后按右→左阅读（日漫习惯）" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource SectionTitleText}" Text="数据与文件关联" Margin="0,26,0,10"/>
            <WrapPanel>
                <Button Style="{StaticResource BaseButton}" Content="打开数据目录" Click="OpenDataDir_Click" Margin="0,0,10,10"/>
                <Button Style="{StaticResource BaseButton}" Content="备份进度数据库" Click="Backup_Click" Margin="0,0,10,10"/>
                <Button Style="{StaticResource BaseButton}" Content="注册文件关联（双击打开）" Click="RegisterAssoc_Click" Margin="0,0,10,10"/>
            </WrapPanel>

            <TextBlock x:Name="HintText" Style="{StaticResource CaptionText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>
