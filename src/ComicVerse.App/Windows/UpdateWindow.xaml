<Window x:Class="ComicVerse.App.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ComicVerse — 应用更新" Icon="/Assets/appicon.png"
        Width="600" Height="470" MinWidth="500" MinHeight="430"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}" FontFamily="{StaticResource AppFont}"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="应用更新" Style="{StaticResource PageTitleText}"/>
            <TextBlock Text="获取 ComicVerse 的最新正式版本" Style="{StaticResource BodyText}" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CardRadius}" Padding="18,14" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="安装版本" Style="{StaticResource CaptionText}"/>
                    <TextBlock x:Name="InstalledVersionText" Style="{StaticResource SectionTitleText}" Margin="0,5,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>
                <StackPanel Grid.Column="2" Margin="18,0,0,0">
                    <TextBlock Text="最新版本" Style="{StaticResource CaptionText}"/>
                    <TextBlock x:Name="LatestVersionText" Text="—" Style="{StaticResource SectionTitleText}" Margin="0,5,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,20,0,16">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="正在检查更新…" Style="{StaticResource SectionTitleText}"
                           AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap"/>
                <TextBlock x:Name="DetailText" Text="正在连接官方发布源。" Style="{StaticResource BodyText}"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,16,0,0">
                    <ProgressBar x:Name="DownloadProgressBar" Height="6" Minimum="0" Maximum="100"
                                 Background="{DynamicResource ProgressTrackBrush}"
                                 Foreground="{DynamicResource AccentSolidBrush}" BorderThickness="0"
                                 AutomationProperties.Name="更新下载进度"/>
                    <TextBlock x:Name="ProgressText" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock x:Name="PackageSizeText" Style="{StaticResource CaptionText}" Visibility="Collapsed"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ReleasePageButton" Content="官方发布页" Style="{StaticResource BaseButton}"
                    Background="Transparent" HorizontalAlignment="Left" Click="ReleasePage_Click"
                    ToolTip="查看官方版本说明和下载" Padding="0,7" Margin="0,0,14,0"/>
            <Button x:Name="CancelButton" Grid.Column="1" Content="取消检查" Style="{StaticResource BaseButton}"
                    MinWidth="82" Click="Cancel_Click" Margin="0,0,10,0"/>
            <Button x:Name="ActionButton" Grid.Column="2" Content="检查更新" Style="{StaticResource AccentButton}"
                    MinWidth="116" IsDefault="True" IsEnabled="False" Click="Action_Click"/>
        </Grid>
    </Grid>
</Window>
