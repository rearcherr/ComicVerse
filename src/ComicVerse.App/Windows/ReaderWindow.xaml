<Window x:Class="ComicVerse.App.Windows.ReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ComicVerse.App.Controls"
        Title="ComicVerse — 阅读"
        Width="1360" Height="900" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ReaderBgBrush}"
        FontFamily="Microsoft YaHei UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewMouseMove="Window_PreviewMouseMove">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border x:Name="TopBar" Grid.Row="0" Background="{DynamicResource WindowBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" ToolTip="返回书架 (Esc)" Click="Back_Click">
                    <TextBlock Text="◀" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitleText}" MaxWidth="420"
                               TextTrimming="CharacterEllipsis"/>
                    <Border x:Name="TypeBadge" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8"
                            Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TypeBadgeText" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BookmarkButton" Style="{StaticResource IconButton}" ToolTip="书签 (B)" Click="BookmarkButton_Click">
                        <TextBlock Text="★" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                    <Button x:Name="ChaptersButton" Style="{StaticResource IconButton}" ToolTip="章节目录" Click="ChaptersButton_Click" Visibility="Collapsed">
                        <TextBlock Text="☷" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                    <Button x:Name="SettingsPanelButton" Style="{StaticResource IconButton}" ToolTip="排版设置" Click="SettingsPanelButton_Click" Visibility="Collapsed">
                        <TextBlock Text="🅐" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="深浅主题" Click="Theme_Click">
                        <TextBlock x:Name="ReaderThemeGlyph" Text="☾" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="全屏 (F)" Click="Fullscreen_Click">
                        <TextBlock Text="⛶" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <RadioButton x:Name="ModePaged" Style="{StaticResource SegmentRadio}" Content="翻页" GroupName="ReaderMode"
                                 IsChecked="True" Checked="Mode_Changed" Margin="0,0,6,0" Tag="paged"/>
                    <RadioButton x:Name="ModeWebtoon" Style="{StaticResource SegmentRadio}" Content="条漫" GroupName="ReaderMode"
                                 Checked="Mode_Changed" Margin="0,0,6,0" Tag="webtoon"/>
                    <RadioButton x:Name="ModeDouble" Style="{StaticResource SegmentRadio}" Content="双页" GroupName="ReaderMode"
                                 Checked="Mode_Changed" Tag="double"/>
                    <Button x:Name="RtlButton" Style="{StaticResource IconButton}" ToolTip="日漫右→左方向" Click="Rtl_Click" Margin="8,0,0,0">
                        <TextBlock x:Name="RtlGlyph" Text="⇄" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 内容区 -->
        <Grid x:Name="ContentGrid" Grid.Row="1" Background="{DynamicResource ReaderBgBrush}">

            <!-- 漫画：单页翻页 -->
            <Grid x:Name="ComicPagedView" Visibility="Visible">
                <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              SizeChanged="PageScroll_SizeChanged" Background="Transparent">
                    <Grid x:Name="PageHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="PageImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.RenderTransform>
                                <ScaleTransform x:Name="PageScale" ScaleX="1" ScaleY="1"/>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </ScrollViewer>

                <Grid x:Name="ClickZones">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="ZoneLeft_Click"/>
                    <Border Grid.Column="1" Background="Transparent" MouseLeftButtonDown="ZoneMiddle_Click"/>
                    <Border Grid.Column="2" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="ZoneRight_Click"/>
                </Grid>

                <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                            Background="Transparent" Cursor="Hand" MouseLeftButtonDown="LoadingPanel_MouseLeftButtonDown">
                    <TextBlock Text="◌" FontSize="34" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LoadingText" Text="正在加载…" FontSize="12" Foreground="{DynamicResource TextFaintBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 漫画：条漫 -->
            <controls:WebtoonViewer x:Name="WebtoonView" Visibility="Collapsed"/>

            <!-- 漫画：双页 -->
            <Grid x:Name="DoubleView" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="LeftScroll" Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <Image x:Name="LeftImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"/>
                </ScrollViewer>
                <Border Grid.Column="1" Width="16" Background="Transparent"/>
                <ScrollViewer x:Name="RightScroll" Grid.Column="2" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <Image x:Name="RightImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"/>
                </ScrollViewer>
                <StackPanel x:Name="DoubleLoading" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="◌" FontSize="34" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="正在加载…" FontSize="12" Foreground="{DynamicResource TextFaintBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 小说 -->
            <Grid x:Name="NovelView" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ChapterPanel" Grid.Column="0" Width="230" Background="{DynamicResource WindowBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="目录" Style="{StaticResource SectionTitleText}" Margin="16,14,16,10"/>
                        <ListBox x:Name="ChapterList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="ChapterList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="Padding" Value="16,7"/>
                                    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <FlowDocumentPageViewer x:Name="NovelPaged" Background="{DynamicResource ReaderBgBrush}"
                                            Zoom="100"/>
                    <FlowDocumentScrollViewer x:Name="NovelScroll" Visibility="Collapsed"
                                              Background="{DynamicResource ReaderBgBrush}"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              IsToolBarVisible="False"
                                              PreviewMouseWheel="NovelScroll_PreviewMouseWheel"/>
                </Grid>

                <Border x:Name="SettingsPanel" Grid.Column="2" Width="280" Background="{DynamicResource WindowBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18,16,18,24">
                            <TextBlock Style="{StaticResource SectionTitleText}" Text="排版"/>

                            <TextBlock Style="{StaticResource BodyText}" Text="阅读方式" Margin="0,16,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="NovelModePaged" Style="{StaticResource SegmentRadio}" Content="翻页"
                                             GroupName="NovelMode" IsChecked="True" Checked="NovelMode_Changed" Margin="0,0,6,0"/>
                                <RadioButton x:Name="NovelModeScroll" Style="{StaticResource SegmentRadio}" Content="滚动"
                                             GroupName="NovelMode" Checked="NovelMode_Changed"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource BodyText}" Text="字体" Margin="0,16,0,6"/>
                            <ComboBox x:Name="FontCombo" Style="{StaticResource ComboStyle}" SelectionChanged="NovelSetting_Changed"/>

                            <TextBlock Style="{StaticResource BodyText}" Text="字号" Margin="0,14,0,2"/>
                            <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="32" TickFrequency="1" Value="18"
                                    ValueChanged="NovelSettingSlider_Changed"/>

                            <TextBlock Style="{StaticResource BodyText}" Text="行距" Margin="0,14,0,2"/>
                            <Slider x:Name="LineSpacingSlider" Minimum="1.2" Maximum="2.5" TickFrequency="0.1" Value="1.7"
                                    ValueChanged="NovelSettingSlider_Changed"/>

                            <TextBlock Style="{StaticResource BodyText}" Text="段间距" Margin="0,14,0,2"/>
                            <Slider x:Name="ParagraphSpacingSlider" Minimum="0" Maximum="24" TickFrequency="2" Value="8"
                                    ValueChanged="NovelSettingSlider_Changed"/>

                            <TextBlock Style="{StaticResource BodyText}" Text="页边距" Margin="0,14,0,2"/>
                            <Slider x:Name="MarginSlider" Minimum="24" Maximum="120" TickFrequency="4" Value="56"
                                    ValueChanged="NovelSettingSlider_Changed"/>

                            <TextBlock Style="{StaticResource BodyText}" Text="文字颜色" Margin="0,14,0,6"/>
                            <ComboBox x:Name="TextColorCombo" Style="{StaticResource ComboStyle}" SelectionChanged="NovelSetting_Changed">
                                <ComboBoxItem Content="默认" Tag="#E8E8F4"/>
                                <ComboBoxItem Content="纯白" Tag="#FFFFFF"/>
                                <ComboBoxItem Content="米黄" Tag="#F5E6C8"/>
                                <ComboBoxItem Content="深墨字" Tag="#2F2A3E"/>
                                <ComboBoxItem Content="墨黑" Tag="#1F1F28"/>
                                <ComboBoxItem Content="青绿" Tag="#C9F2E0"/>
                            </ComboBox>

                            <TextBlock Style="{StaticResource BodyText}" Text="背景色" Margin="0,14,0,6"/>
                            <ComboBox x:Name="BgColorCombo" Style="{StaticResource ComboStyle}" SelectionChanged="NovelSetting_Changed">
                                <ComboBoxItem Content="深蓝紫" Tag="#1A1A2E"/>
                                <ComboBoxItem Content="纯黑" Tag="#101014"/>
                                <ComboBoxItem Content="米白" Tag="#FBF4E8"/>
                                <ComboBoxItem Content="浅色阅读白" Tag="#FAF6F8"/>
                                <ComboBoxItem Content="淡粉白" Tag="#FFF5F7"/>
                            </ComboBox>

                            <Separator Margin="0,18,0,14" Background="{DynamicResource BorderBrush}"/>

                            <TextBlock Style="{StaticResource BodyText}" Text="文本编码（TXT）" Margin="0,0,0,6"/>
                            <ComboBox x:Name="EncodingCombo" Style="{StaticResource ComboStyle}" SelectionChanged="Encoding_Changed">
                                <ComboBoxItem Content="自动检测"/>
                                <ComboBoxItem Content="UTF-8"/>
                                <ComboBoxItem Content="GBK"/>
                                <ComboBoxItem Content="Big5"/>
                                <ComboBoxItem Content="Shift-JIS"/>
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <TextBlock Text="自动滚动" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                                <ToggleButton x:Name="AutoScrollToggle" Style="{StaticResource ToggleSwitch}" Margin="12,0,0,0"
                                              Checked="AutoScroll_Changed" Unchecked="AutoScroll_Changed"/>
                            </StackPanel>
                            <Slider x:Name="AutoSpeedSlider" Minimum="20" Maximum="160" TickFrequency="10" Value="60"
                                    Margin="0,10,0,0" ToolTip="滚动速度"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 书签浮层 -->
            <Border x:Name="BookmarkPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Width="320"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Margin="0,10,10,0" Visibility="Collapsed"
                    MaxHeight="420">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,12,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="书签" Style="{StaticResource SectionTitleText}"/>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="关闭" Click="BookmarkPanelClose_Click">
                            <TextBlock Text="✕" FontSize="13"/>
                        </Button>
                    </Grid>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource BaseButton}" Content="＋ 添加当前页书签" Margin="12,0,12,12"
                            Click="AddBookmark_Click"/>
                    <ListBox x:Name="BookmarkList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="BookmarkList_PreviewMouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Display}" FontSize="12"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding TimeText}" FontSize="10"
                                                   Foreground="{DynamicResource TextFaintBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="✕"
                                            Tag="{Binding}" Click="DeleteBookmark_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <StackPanel x:Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                        MaxWidth="560">
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" TextAlignment="Center" FontSize="14"
                           Foreground="{DynamicResource DangerBrush}"/>
                <Button Content="返回书架" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="0,16,0,0"
                        Click="Back_Click"/>
            </StackPanel>
        </Grid>

        <!-- 底栏 -->
        <Border x:Name="BottomBar" Grid.Row="2" Background="{DynamicResource WindowBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrevButton" Style="{StaticResource IconButton}" ToolTip="上一页 (←/PageUp)" Click="Prev_Click">
                        <TextBlock Text="◀" FontSize="14"/>
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource IconButton}" ToolTip="下一页 (→/PageDown)" Click="Next_Click" Margin="4,0,0,0">
                        <TextBlock Text="▶" FontSize="14"/>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ZoomOutButton" Style="{StaticResource IconButton}" ToolTip="缩小 (-)" Click="ZoomOut_Click" Visibility="Collapsed">
                        <TextBlock Text="−" FontSize="15"/>
                    </Button>
                    <TextBlock x:Name="ZoomText" Text="100%" FontSize="11" VerticalAlignment="Center" Margin="6,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                    <Slider x:Name="ZoomSlider" Width="130" Minimum="20" Maximum="300" Value="100" Visibility="Collapsed"
                            ValueChanged="ZoomSlider_ValueChanged" VerticalAlignment="Center"/>
                    <Button x:Name="ZoomInButton" Style="{StaticResource IconButton}" ToolTip="放大 (+)" Click="ZoomIn_Click" Visibility="Collapsed">
                        <TextBlock Text="＋" FontSize="14"/>
                    </Button>
                    <Button x:Name="FitWidthButton" Style="{StaticResource IconButton}" ToolTip="适应宽度" Click="FitWidth_Click" Margin="8,0,0,0" Visibility="Collapsed">
                        <TextBlock Text="⇔" FontSize="14"/>
                    </Button>
                    <Button x:Name="FitPageButton" Style="{StaticResource IconButton}" ToolTip="适应整页" Click="FitPage_Click" Margin="4,0,0,0" Visibility="Collapsed">
                        <TextBlock Text="⛶" FontSize="13"/>
                    </Button>
                    <Button x:Name="ActualButton" Style="{StaticResource IconButton}" ToolTip="原始大小" Click="Actual_Click" Margin="4,0,0,0" Visibility="Collapsed">
                        <TextBlock Text="1:1" FontSize="11"/>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PageInfoText" Text="1 / 1" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Slider x:Name="ProgressSlider" Width="280" Minimum="0" Maximum="1000" Value="0"
                            Margin="14,0,0,0" VerticalAlignment="Center"
                            ValueChanged="ProgressSlider_ValueChanged"
                            PreviewMouseDown="ProgressSlider_PreviewMouseDown"
                            PreviewMouseUp="ProgressSlider_PreviewMouseUp"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
