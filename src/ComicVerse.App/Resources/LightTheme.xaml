<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowBgColor">#FFF5F7</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F6EFF7</Color>
    <Color x:Key="SurfaceHoverColor">#EFE2F2</Color>
    <Color x:Key="TextPrimaryColor">#2F2A3E</Color>
    <Color x:Key="TextSecondaryColor">#7C7698</Color>
    <Color x:Key="TextFaintColor">#B0AAC8</Color>
    <Color x:Key="BorderColor">#E9DEEA</Color>
    <Color x:Key="AccentColor">#F35A8E</Color>
    <Color x:Key="Accent2Color">#B642D8</Color>
    <Color x:Key="ReaderBgColor">#FAF6F8</Color>
    <Color x:Key="ProgressTrackColor">#EADFE9</Color>
    <Color x:Key="DangerColor">#E5484D</Color>
    <Color x:Key="SuccessColor">#2FBF8F</Color>

    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}"/>
    <SolidColorBrush x:Key="ReaderBgBrush" Color="{StaticResource ReaderBgColor}"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="{StaticResource ProgressTrackColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
        <GradientStop Color="{StaticResource Accent2Color}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF7FA8" Offset="0"/>
        <GradientStop Color="#9B6CF6" Offset="0.55"/>
        <GradientStop Color="#D05CF0" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
