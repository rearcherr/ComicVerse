<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题：与深色共用同一套中性灰阶与品牌玫红，保证两种模式层级一致 -->
    <Color x:Key="WindowBgColor">#F5F6F8</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#EFF1F4</Color>
    <Color x:Key="SurfaceHoverColor">#E3E6EB</Color>
    <Color x:Key="TextPrimaryColor">#14161A</Color>
    <Color x:Key="TextSecondaryColor">#545B67</Color>
    <Color x:Key="TextFaintColor">#868D99</Color>
    <Color x:Key="BorderColor">#DCE0E6</Color>
    <Color x:Key="AccentColor">#C0275F</Color>
    <Color x:Key="AccentSolidColor">#AE1F55</Color>
    <Color x:Key="AccentSoftColor">#FBEDF2</Color>
    <Color x:Key="Accent2Color">#C0275F</Color>
    <Color x:Key="ReaderBgColor">#E9EBEF</Color>
    <Color x:Key="ProgressTrackColor">#DCE0E6</Color>
    <Color x:Key="DangerColor">#B23A32</Color>
    <Color x:Key="SuccessColor">#2E7D5B</Color>

    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSolidBrush" Color="{StaticResource AccentSolidColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}"/>
    <SolidColorBrush x:Key="ReaderBgBrush" Color="{StaticResource ReaderBgColor}"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="{StaticResource ProgressTrackColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AccentSolidColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F1F3F6" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
