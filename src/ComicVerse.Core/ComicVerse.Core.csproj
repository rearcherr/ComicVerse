<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0-android</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ComicVerse.Core</RootNamespace>
  </PropertyGroup>

  <!-- 桌面端（WPF）自有平台层：位图解码、封面渲染、PDF 原生渲染、FlowDocument 排版 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- 安卓端平台层：BitmapFactory / Canvas / PdfRenderer -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SharpCompress" Version="0.50.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="bblanchon.PDFium.Win32" Version="153.0.7988" />
    <EmbeddedResource Include="$(NuGetPackageRoot)bblanchon.pdfium.win32\153.0.7988\runtimes\win-x64\native\pdfium.dll"
                      LogicalName="pdfium.dll" />
  </ItemGroup>

  <!-- 平台实现二选一：安卓目标排除 WPF 文件，Windows 目标排除 Android 文件 -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="ImageHelper.cs" />
    <Compile Remove="PdfNative.cs" />
    <Compile Remove="Comics\PdfNativeRenderer.cs" />
    <Compile Remove="Comics\PdfComicSource.cs" />
    <Compile Remove="Comics\IPageBitmapSource.cs" />
    <Compile Remove="Novel\NovelDocumentBuilder.cs" />
    <Compile Remove="Services\ComicImageLoader.cs" />
    <Compile Remove="Services\CoverGenerator.cs" />
    <Compile Remove="Services\ImageCacheService.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-android'">
    <Compile Remove="Android\**\*.cs" />
  </ItemGroup>

</Project>
